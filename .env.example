# Copy this file to .env and fill in your own values.
# Never commit the real .env — it holds credentials.

# --- Database -----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nuqtah_inv
DB_USER=root
DB_PASS=

# --- Application --------------------------------------------------------------
# Used for absolute links inside outgoing email.
APP_URL=http://localhost/Nuqtah_IT

# --- SMTP (only used when DEMO_MODE is not "true") ----------------------------
MAIL_EMAIL=
MAIL_PASSWORD=

# --- Read-only demo -----------------------------------------------------------
# "true"  -> all writes are blocked and email is redirected to storage/mail.log
# unset   -> normal, fully functional behaviour
DEMO_MODE=false
